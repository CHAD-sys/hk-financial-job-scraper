# Backend deployment env vars (set these in Railway → backend service → Variables).
# Copy to .env for local use. NEVER commit a real .env — it is gitignored.

# Where the SQLite jobs.db lives. On Railway, point this at the mounted volume.
JOBS_DB_PATH=/data/jobs.db

# CORS: the deployed frontend origin(s), comma-separated. Use "*" for a public
# demo with no logins. Example: https://your-frontend.up.railway.app
CORS_ORIGINS=*

# Optional: seed the DB on first boot if JOBS_DB_PATH doesn't exist yet.
# Point this at a downloadable jobs.db snapshot (e.g. a GitHub Release asset).
# Leave unset if you upload the DB to the volume manually.
# DB_SEED_URL=https://example.com/jobs.db
