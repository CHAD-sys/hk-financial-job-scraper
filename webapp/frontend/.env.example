# Frontend build-time env. Copy to .env.local for local dev.
# Vite only exposes VITE_-prefixed vars, and it bakes them in at BUILD time —
# so this is a build setting, not something the running server can change.

# Base URL of the API. Leave it EMPTY.
#
# Empty means the app calls relative /api paths, which is what the single-origin
# setup requires: one FastAPI service now serves both this bundle and the API,
# so there is no second origin to point at. In dev, Vite's proxy (see
# vite.config.ts) forwards those same /api calls to the backend on :8000, so the
# one empty value is correct everywhere. Putting an absolute URL back here splits
# the UI and API across two origins again, which is exactly what breaks session
# cookies — see docs/adr/0005.
VITE_API_URL=
