# Database
data/*.db
data/*.db-shm
data/*.db-wal
data/

# Secrets & config
config/
.env
*.env
api_keys.txt

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Logs & output
logs/
*.log
outputs/

# Build / packaging
dist/
# NOTE: webapp/backend/frontend_dist/ (the frontend bundle folded into the
# backend's Railway upload for single-origin, ADR 0005) is deliberately NOT
# listed here. `railway up` respects .gitignore when building its upload
# snapshot, so ignoring it here silently excludes it from the deploy. It
# stays untracked by discipline (never `git add`ed) instead — see the
# "Committing" section of the rail-it skill for the same convention.
build/
*.egg-info/
.ruff_cache/
.pytest_cache/
.coverage

# macOS
.DS_Store

# IDE
.vscode/
.idea/
data/backups/

# Webapp (Node / Vite)
node_modules/
**/node_modules/
.vite/
**/.vite/
webapp/frontend/dist/
webapp/backend/.venv/

# Explicit secret/data guards (belt-and-suspenders)
config/api_keys.env
**/.env
data/jobs.db
data/jobs.db-shm
data/jobs.db-wal

# graphify local cache (keep graph artifacts, drop cache). `.vocab.txt` is a
# regenerable wordlist derived from the graph for query expansion — same family
# as the .graphify_* files, just without the prefix.
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/.vocab.txt

# graphify per-run snapshots. Every run writes a dated directory carrying a
# full ~11 MB graph.json; 25 of them had accumulated to 274 MB against a 129 MB
# .git, and `origin` fans out to the PUBLIC CHAD-sys mirror, so tracking them
# triples the repo permanently and in history. The current graph at
# graphify-out/ (GRAPH_REPORT.md, graph.json, manifest.json) stays tracked —
# that is the one a reader wants. Dated dirs already committed before this rule
# keep their history; .gitignore does not untrack what is already tracked.
graphify-out/20??-??-??/

# graphify session memory — 129 markdown transcripts of past conversations,
# filenames included. Local recall aid, not source, and not something to
# publish to a public mirror.
graphify-out/memory/

# PocketBase (verification mirror) — binary + local data, not source
pocketbase/
pb_data_export_*.tar.gz

# Third-party salary guide PDF (copyrighted, large) — keep the derived .md doc only
salary_guidlines/*.pdf

# Editor / agent config
**/.claude/
.claude/
.agents/
.codex/

# Recovery scratch from a specific incident (.wip-recovery/README.md) — compiled
# .pyc + disassembly notes, not source. Kept on disk, never committed.
.wip-recovery/

# Backup files (editor / manual snapshots — never source). The plain suffix and
# the timestamped form scripts actually write (`name.json.bak-20260826-201800`)
# both need a pattern — `*.bak` alone never matched the latter.
*.bak
*.bak-*

# Large generated artifacts (regenerated on demand; not source of truth)
jobs_export.csv
pb_boss_bundle.zip

# Stray local database / scratch dirs (belt-and-suspenders alongside data/*.db —
# these have shown up at the repo root, not just under data/)
/jobs.db
/tmp/
/output/
hk_jobs/daily_run/graphify-out/
