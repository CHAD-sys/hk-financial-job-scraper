# Scraper environment. Copy to .env (gitignored) or export directly.

# DeepSeek API key — used by:
#   - hk_jobs/enrichers/deepseek.py  (AI enrichment: skills/seniority/salary/summary)
#   - hk_jobs/llm_client.py          (Longtail adapter: LLM job extraction)
# OpenAI-compatible chat/completions endpoint (https://api.deepseek.com).
DEEPSEEK_API_KEY=sk-your-key-here

# Scheduled pipeline result email. Keep SMTP_PASS in a local .env or encrypted
# GitHub Actions secret; never commit the real app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFY_EMAILS=amine@finexclub.org,mohamedaminechahid@gmail.com

# Fixed operator inbox for moderated recruiter Role submissions.
SUBMISSION_EMAIL=amine@finexclub.org

# Stable random secret for short-lived Role detail grants. Generate once for
# production (for example: openssl rand -hex 32) and keep it in Railway only.
ROLE_ACCESS_SECRET=replace-with-a-long-random-secret
